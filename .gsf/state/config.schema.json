{
  "description": "Schema for GSF configuration",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "agents": { "type": "array", "items": { "type": "string" } },
    "autonomy_level": { "type": "string", "enum": ["low", "medium", "high"] }
  },
  "required": ["version", "agents"]
}
