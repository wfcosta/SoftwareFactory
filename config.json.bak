{
  "base_branch": "main",
  "checks": [
    "Replace with the repository's test command",
    "Replace with its lint/typecheck/build commands when applicable"
  ],
  "protected_paths": [
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/AGENTS.md",
    "**/SECURITY.md"
  ],
  "required_reviewers": ["code"],
  "surface_reviewers": {
    "security": ["security"],
    "ui": ["ux", "ui"]
  },
  "max_review_rounds": 3,
  "pr_title": "[Factory] <short change summary>",
  "pr_body_sections": ["Summary", "Validation", "Review notes", "Closes #<issue>"],
  "autonomy": {
    "publish_pr": true,
    "merge_pr": false,
    "deploy": false,
    "assume_operational_gaps_only": true,
    "orchestrator_resolves_questions": true
  },
  "stop_classes": {
    "factory_bug": "ledger + correct prompts/config; retry or fail closed",
    "environment": "ledger; fail closed; never invent PASS",
    "product": "gaps.md; fail closed; do not invent UX"
  },
  "orca": {
    "require_runtime": true,
    "orchestration_experimental": true,
    "default_worker_agent": "codex",
    "agent_overrides": {
      "builder": "codex",
      "reviewer-security": "claude",
      "reviewer-ux": "claude",
      "reviewer-ui": "codex"
    },
    "check_timeout_ms": 900000,
    "empty_waits_before_worker_list": 3,
    "builder_worktree": "new-child",
    "forbid_ui_handoff": true,
    "forbid_unsupervised_worktree_handoff": true,
    "dag": {
      "chained": ["intake", "spec", "builder", "checks", "approver"],
      "parallel_after_gate": ["reviewers"]
    }
  }
}
